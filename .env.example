# Copy this file to ".env" and fill in one key (both notebooks look for it at the repository root).

# Option 1: Cerebras (https://cloud.cerebras.ai), used first when it is set
CEREBRAS_API_KEY=your_cerebras_api_key_here

# Option 2: Groq's free tier (https://console.groq.com/keys), used when no Cerebras key is set
# GROQ_API_KEY=your_groq_api_key_here
